digraph DB {
  rankdir=LR;
  graph [bgcolor="white", pad="0.6", nodesep="0.4", ranksep="2.4", splines="spline", overlap=false];
  node [shape=plaintext, fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=10, color="#0E2D5C", penwidth=1.4];

  dim_category [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
  <TR><TD BGCOLOR="#0E2D5C" COLSPAN="3"><FONT COLOR="white"><B>dim_category</B></FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="category_id"><FONT COLOR="#E76F51"><B>PK</B></FONT></TD><TD ALIGN="LEFT">category_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="category_name"></TD><TD ALIGN="LEFT">category_name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(50)</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="m_path"></TD><TD ALIGN="LEFT">m_path</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(50)</FONT></TD></TR>
</TABLE>>];
  dim_sku [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
  <TR><TD BGCOLOR="#0E2D5C" COLSPAN="3"><FONT COLOR="white"><B>dim_sku</B></FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="sku_id"><FONT COLOR="#E76F51"><B>PK</B></FONT></TD><TD ALIGN="LEFT">sku_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="sku_name"></TD><TD ALIGN="LEFT">sku_name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(80)</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="category_id"><FONT COLOR="#E76F51"><B>FK</B></FONT></TD><TD ALIGN="LEFT">category_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="brand"></TD><TD ALIGN="LEFT">brand</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(50)</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="weight_kg"></TD><TD ALIGN="LEFT">weight_kg</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(6,2)</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="unit_price"></TD><TD ALIGN="LEFT">unit_price</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(10,2)</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="is_active"></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BOOLEAN</FONT></TD></TR>
</TABLE>>];
  dim_store [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
  <TR><TD BGCOLOR="#0E2D5C" COLSPAN="3"><FONT COLOR="white"><B>dim_store</B></FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="store_id"><FONT COLOR="#E76F51"><B>PK</B></FONT></TD><TD ALIGN="LEFT">store_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="store_name"></TD><TD ALIGN="LEFT">store_name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(80)</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="city"></TD><TD ALIGN="LEFT">city</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(50)</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="region"></TD><TD ALIGN="LEFT">region</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(50)</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="manager_name"></TD><TD ALIGN="LEFT">manager_name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(80)</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="manager_email"></TD><TD ALIGN="LEFT">manager_email</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(80)</FONT></TD></TR>
</TABLE>>];
  dim_holidays [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
  <TR><TD BGCOLOR="#0E2D5C" COLSPAN="3"><FONT COLOR="white"><B>dim_holidays</B></FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="holiday_date"><FONT COLOR="#E76F51"><B>PK</B></FONT></TD><TD ALIGN="LEFT">holiday_date</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATE</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="holiday_name"></TD><TD ALIGN="LEFT">holiday_name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(80)</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="country"></TD><TD ALIGN="LEFT">country</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">CHAR(2)</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="is_promo_period"></TD><TD ALIGN="LEFT">is_promo_period</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BOOLEAN</FONT></TD></TR>
</TABLE>>];
  dim_promo_calendar [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
  <TR><TD BGCOLOR="#0E2D5C" COLSPAN="3"><FONT COLOR="white"><B>dim_promo_calendar</B></FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="promo_id"><FONT COLOR="#E76F51"><B>PK</B></FONT></TD><TD ALIGN="LEFT">promo_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="sku_id"><FONT COLOR="#E76F51"><B>FK</B></FONT></TD><TD ALIGN="LEFT">sku_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="store_id"><FONT COLOR="#E76F51"><B>FK</B></FONT></TD><TD ALIGN="LEFT">store_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="start_date"></TD><TD ALIGN="LEFT">start_date</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATE</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="end_date"></TD><TD ALIGN="LEFT">end_date</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATE</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="discount_pct"></TD><TD ALIGN="LEFT">discount_pct</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="reason"></TD><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(80)</FONT></TD></TR>
</TABLE>>];
  sales_fact [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
  <TR><TD BGCOLOR="#0E2D5C" COLSPAN="3"><FONT COLOR="white"><B>sales_fact</B></FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="sales_id"><FONT COLOR="#E76F51"><B>PK</B></FONT></TD><TD ALIGN="LEFT">sales_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="sales_date"></TD><TD ALIGN="LEFT">sales_date</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATE</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="sku_id"><FONT COLOR="#E76F51"><B>FK</B></FONT></TD><TD ALIGN="LEFT">sku_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="store_id"><FONT COLOR="#E76F51"><B>FK</B></FONT></TD><TD ALIGN="LEFT">store_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="qty"></TD><TD ALIGN="LEFT">qty</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="price"></TD><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(10,2)</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="promo"></TD><TD ALIGN="LEFT">promo</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BOOLEAN</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="amount"></TD><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(12,2)</FONT></TD></TR>
</TABLE>>];
  inventory_snapshot [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
  <TR><TD BGCOLOR="#0E2D5C" COLSPAN="3"><FONT COLOR="white"><B>inventory_snapshot</B></FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="inventory_id"><FONT COLOR="#E76F51"><B>PK</B></FONT></TD><TD ALIGN="LEFT">inventory_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="snapshot_date"></TD><TD ALIGN="LEFT">snapshot_date</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATE</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="sku_id"><FONT COLOR="#E76F51"><B>FK</B></FONT></TD><TD ALIGN="LEFT">sku_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="store_id"><FONT COLOR="#E76F51"><B>FK</B></FONT></TD><TD ALIGN="LEFT">store_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="qty_on_hand"></TD><TD ALIGN="LEFT">qty_on_hand</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="qty_in_transit"></TD><TD ALIGN="LEFT">qty_in_transit</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="last_updated_ts"></TD><TD ALIGN="LEFT">last_updated_ts</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">TIMESTAMP</FONT></TD></TR>
</TABLE>>];
  dataset [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
  <TR><TD BGCOLOR="#E76F51" COLSPAN="3"><FONT COLOR="white"><B>dataset</B></FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="sales_date"></TD><TD ALIGN="LEFT">sales_date</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATE</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="week_start_date"></TD><TD ALIGN="LEFT">week_start_date</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATE</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="sku_id"><FONT COLOR="#E76F51"><B>FK</B></FONT></TD><TD ALIGN="LEFT">sku_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="store_id"><FONT COLOR="#E76F51"><B>FK</B></FONT></TD><TD ALIGN="LEFT">store_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="category_id"><FONT COLOR="#E76F51"><B>FK</B></FONT></TD><TD ALIGN="LEFT">category_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="category_name"></TD><TD ALIGN="LEFT">category_name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(50)</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="brand"></TD><TD ALIGN="LEFT">brand</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(50)</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="weight_kg"></TD><TD ALIGN="LEFT">weight_kg</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(6,2)</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="city"></TD><TD ALIGN="LEFT">city</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(50)</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="region"></TD><TD ALIGN="LEFT">region</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(50)</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="qty"></TD><TD ALIGN="LEFT">qty</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="price"></TD><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(10,2)</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="amount"></TD><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(12,2)</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="promo"></TD><TD ALIGN="LEFT">promo</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BOOLEAN</FONT></TD></TR>
  <TR><TD WIDTH="40" ALIGN="CENTER" PORT="is_holiday"></TD><TD ALIGN="LEFT">is_holiday</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BOOLEAN</FONT></TD></TR>
</TABLE>>];

  // Layout: 4 ranks left → right
  { rank=same; dim_category; dim_holidays; }
  { rank=same; dim_sku; dim_store; }
  { rank=same; sales_fact; inventory_snapshot; dim_promo_calendar; }
  { rank=same; dataset; }

  // Невидимі edges для ранжування зліва направо
  dim_category -> dim_sku [style=invis];
  dim_sku -> sales_fact [style=invis];
  sales_fact -> dataset [style=invis];

  // FK-зв'язки (від parent до child, з відображенням кардинальності 1 : N)
  dim_category:category_id:e -> dim_sku:category_id:w [label="1 : N", arrowhead=crow, arrowtail=none];
  dim_sku:sku_id:e -> dim_promo_calendar:sku_id:w [label="1 : N", arrowhead=crow, arrowtail=none];
  dim_store:store_id:e -> dim_promo_calendar:store_id:w [label="1 : N", arrowhead=crow, arrowtail=none];
  dim_sku:sku_id:e -> sales_fact:sku_id:w [label="1 : N", arrowhead=crow, arrowtail=none];
  dim_store:store_id:e -> sales_fact:store_id:w [label="1 : N", arrowhead=crow, arrowtail=none];
  dim_sku:sku_id:e -> inventory_snapshot:sku_id:w [label="1 : N", arrowhead=crow, arrowtail=none];
  dim_store:store_id:e -> inventory_snapshot:store_id:w [label="1 : N", arrowhead=crow, arrowtail=none];

  // JOIN-зв'язки до dataset — constraint=false, не впливають на layout
  sales_fact:sku_id:e -> dataset:sku_id:w [label="JOIN", color="#E76F51", fontcolor="#E76F51", style="dashed", arrowhead=open, constraint=false];
  dim_category:category_id:e -> dataset:category_id:w [label="JOIN", color="#E76F51", fontcolor="#E76F51", style="dashed", arrowhead=open, constraint=false];
  dim_store:store_id:e -> dataset:store_id:w [label="JOIN", color="#E76F51", fontcolor="#E76F51", style="dashed", arrowhead=open, constraint=false];
}